{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dos Live",
  "version": "0.1.0",
  "identifier": "dev.doncoding.doslive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430"
    },
    "windows": [
      {
        "label": "island",
        "title": "Dos Live",
        "url": "index.html",
        "width": 760,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "© Elijah Ndeto Mutiso",
    "category": "Productivity",
    "shortDescription": "Dos, live on your screen",
    "longDescription": "Dos Live puts Dos at the top of your screen: live pings from your scheduled tasks, one pill per world, questions that need your call, and a voice you can talk to.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}